# Copiez ce fichier en ".env". Aucune valeur n'est requise pour tester le
# projet : par défaut TARGET_LLM_PROVIDER=mock_vulnerable permet de tout
# faire tourner sans clé API, avec des résultats 100% reproductibles.

# --- Fournisseur LLM de la CIBLE testée ---
# Valeurs possibles : mock_vulnerable | openai | azure_openai
# "mock_vulnerable" simule un agent naïf sans défense (baseline reproductible).
# Avec un vrai fournisseur, vous testez la robustesse native d'un LLM réel
# (généralement bien plus résistant que le mock, ce qui est un résultat
# intéressant en soi à documenter).
TARGET_LLM_PROVIDER=mock_vulnerable
LLM_TEMPERATURE=0.0

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<nom-du-deploiement>
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Seuils du garde de sécurité (défense) ---
HEURISTIC_THRESHOLD=0.35
EMBEDDING_THRESHOLD=0.55
